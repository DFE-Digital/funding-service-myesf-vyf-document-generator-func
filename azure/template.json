{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Short name of the environment. Used for the name of resources created."
      }
    },
    "serviceName": {
      "type": "string",
      "metadata": {
        "description": "Short name of the service. Used for the name of resources created."
      }
    },
    "aspSize": {
      "type": "string",
      "defaultValue": "1"
    },
    "aspInstances": {
      "type": "int",
      "defaultValue": 1
    },
    "aspTier": {
      "type": "string",
      "defaultValue": "Basic"
    },
    "sharedResourceGroupName": {
      "type": "string"
    },
    "sharedAppInsightsName": {
      "type": "string"
    },
    "sharedStorageAccountName": {
      "type": "string"
    },
    "sharedCosmosDbName": {
      "type": "string"
    },
    "sharedServiceBusName": {
      "type": "string"
    },
    "SharedKeyVaultName": {
      "type": "string"
    },
    "serviceBusAccessKeyName": {
      "type": "string"
    },
    "queueName": {
      "type": "string"
    },
    "baseSiteUrl": {
      "type": "string"
    },    
    "destinationStorage": {
      "type": "string",
      "defaultValue": "OneDrive"
    },
    "blobStorage_ConnectionString": {
      "type": "string"
    },
    "blobStorage_ContainerName": {
      "type": "string",
      "defaultValue": "generatedpdfs"
    },
    "oneDrive_ClientId": {
      "type": "string"
    },
    "oneDrive_ClientSecret": {
      "type": "string"
    },
    "oneDrive_RefreshToken": {
      "type": "string"
    },
    "oneDrive_RedirectUri": {
      "type": "string"
    },
    "oneDrive_RootPath": {
      "type": "string",
      "defaultValue": "/Documents/"
    },
    "documentGeneratorScheduleTriggerTime": {
      "type": "string",
      "defaultValue": "*/2 * * * *"
    },
    "secretsPermissions": {
      "defaultValue": [
        "list",
        "get"
      ],
      "type": "array",
      "metadata": {
        "description": "Specifies the permissions to secrets in the vault. Valid values are: all, get, list, set, delete, backup, restore, recover, and purge."
      }
    },
    "processingRunSizeComparison": {
      "type": "int",
      "defaultValue": 10
    },
    "keyVaultSecretName": {
      "type": "string",
      "defaultValue": "FileShareStorageCompareConnectionString"
    },
    "filteredFundingStreamsFundings": {
      "type": "string",
      "defaultValue": "1619,LAREC"
    },
    "filteredVariationsProviderFundings": {
      "type": "string",
      "defaultValue": "AuthorityFieldUpdated,EstablishmentNumberFieldUpdated,DfeEstablishmentNumberFieldUpdated,NameFieldUpdated,LACodeFieldUpdated,FundingUpdated,CalculationValuesUpdated,URNFieldUpdated,DateOpenedFieldUpdated,PhaseOfEducationFieldUpdated,ProviderTypeFieldUpdated,ProviderStatusFieldUpdated,IndicativeToLive"
    },
    "filteredVariationsFunding": {
      "type": "string",
      "defaultValue": "AuthorityFieldUpdated,EstablishmentNumberFieldUpdated,DfeEstablishmentNumberFieldUpdated,NameFieldUpdated,LACodeFieldUpdated,FundingUpdated,CalculationValuesUpdated,URNFieldUpdated,DateOpenedFieldUpdated,PhaseOfEducationFieldUpdated,ProviderTypeFieldUpdated,ProviderStatusFieldUpdated,IndicativeToLive"
    },
    "nonRelationalDbCosmosDbConfigurationFundingCollection": {
      "type": "string",
      "defaultValue": "funding"
    },
    "nonRelationalDbCosmosDbConfigurationProviderFundingCollection": {
      "type": "string",
      "defaultValue": "providerfunding"
    },
    "filteredFundingStreamsProviderFundings": {
      "type": "string",
      "defaultValue": "GAG,NMSS,1416,1619,PNA"
    },
    "filteredFundingReasonGroupTypeCodes": {
      "type": "string",
      "defaultValue": "Information:LocalAuthority,Contracting:LocalAuthoritySsf"
    },
    "parallelRunBatchSize": {
      "type": "string",
      "defaultValue": "10"
    },
    "processingBatchSize": {
      "type": "string",
      "defaultValue": "4000"
    }
  },
  "variables": {
    "deploymentUrlBase": "https://raw.githubusercontent.com/SkillsFundingAgency/funding-platform-building-blocks/master/templates/",
    "resourceNamePrefix": "[toLower(concat('pds-', parameters('resourceEnvironmentName'),'-', parameters('serviceName')))]",
    "functionAppName": "[concat(variables('resourceNamePrefix'), 'wkr-fa')]",
    "appServicePlanName": "[concat(variables('resourceNamePrefix'), 'wkr-asp')]"
